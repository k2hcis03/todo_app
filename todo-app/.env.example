# 복사해서 .env.local로 만들고 실제 값을 채운다 (.env.local은 커밋하지 않는다)
# 이 파일에는 자리 표시자만 둔다. 실제 비밀 값을 적지 마세요.

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017
# 생략하면 todo_app을 쓴다
MONGODB_DB=todo_app

# --- GitHub OAuth 로그인 ---
# GitHub > Settings > Developer settings > OAuth Apps 에서 앱을 만들어 받은 값 (README의 "GitHub OAuth 설정" 참고)
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
